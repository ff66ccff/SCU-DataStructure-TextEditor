tests/d1/*.txt -text
tests/week1/*.txt -text
tests/d1/*.txt whitespace=-trailing-space,-blank-at-eof,cr-at-eol
tests/week1/*.txt whitespace=-trailing-space,-blank-at-eof,cr-at-eol
